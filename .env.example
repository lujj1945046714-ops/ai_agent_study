# LLM provider switch
# 默认值：openai_compatible
# JOB_ASSISTANT_LLM_PROVIDER=openai_compatible

# 方案 A：OpenAI-compatible / DeepSeek（兼容旧配置）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 也可改用统一命名（优先级高于 DEEPSEEK_*）
# JOB_ASSISTANT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# JOB_ASSISTANT_LLM_BASE_URL=https://api.deepseek.com
# JOB_ASSISTANT_LLM_MODEL=deepseek-chat
# JOB_ASSISTANT_LLM_WIRE_API=chat_completions

# 方案 B：复用本机 Codex 配置（运行时读取，不复制密钥到项目）
# JOB_ASSISTANT_LLM_PROVIDER=codex
# CODEX_HOME=C:\Users\<you>\.codex
# 可选：Responses 兼容模式。codex 默认 auto，会关闭部分严格参数并在流式失败时回退。
# JOB_ASSISTANT_RESPONSES_COMPAT_MODE=auto

# Optional: GitHub token for API access / README fetch
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# Optional: proxies
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Local paths (optional)
# JOB_ASSISTANT_WORKDIR=.
# JOB_ASSISTANT_DATA_DIR=./data
# JOB_ASSISTANT_OUTPUT_DIR=./output
# JOB_ASSISTANT_USER_OUTPUT_DIR=./output/users
# JOB_ASSISTANT_PROFILES_DIR=./profiles
# JOB_ASSISTANT_DB_PATH=./data/jobs.db
# JOB_ASSISTANT_APP_DB_PATH=./data/app.db
# JOB_ASSISTANT_SESSION_SECRET=change-me-in-production

# Job discovery tuning (optional)
# JOB_ASSISTANT_DISCOVERY_FETCH_CONNECT_TIMEOUT_S=5
# JOB_ASSISTANT_DISCOVERY_FETCH_READ_TIMEOUT_S=12
# JOB_ASSISTANT_DISCOVERY_FOLLOW_PER_LISTING=5
# JOB_ASSISTANT_DISCOVERY_FOLLOW_TOTAL=25
